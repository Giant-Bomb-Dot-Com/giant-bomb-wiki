-- renders precomputed related content for the current page (gb_related via
-- mw.ext.gbrelated); group names come from RelatedStore
local p = {}
local gameQuery = require("Module:GameQuery_CARGO")

local cache

local function fetch()
    if cache == nil then
        cache = mw.ext.gbrelated.get() or {}
    end
    return cache
end

-- {{#invoke:Related|related|developed|limit=20|default=None}}
function p.related(frame)
    local args = frame.args
    local fallback = '<li><em>' .. (args.default or 'None') .. '</em></li>'
    -- positional #invoke args arrive untrimmed
    local group = mw.text.trim(args[1] or '')
    local rows = fetch()[group]
    if not rows or #rows == 0 then
        return fallback
    end
    local items = {}
    for i = 1, math.min(tonumber(args.limit) or 20, #rows) do
        local row = rows[i]
        items[#items + 1] =
            '<li>[[' .. row.title .. '|' .. row.display .. ']]</li>'
    end
    return table.concat(items)
end

-- {{#invoke:Related|cards|developed|limit=12}}
function p.cards(frame)
    local args = frame.args
    local group = mw.text.trim(args[1] or '')
    local rows = fetch()[group]
    if not rows or #rows == 0 then
        return '<div class="no-results">No games found</div>'
    end

    local limit = math.min(tonumber(args.limit) or 12, #rows)
    local titles = {}
    for i = 1, limit do
        titles[i] = rows[i].title:gsub('_', ' ')
    end

    local ok, results = pcall(mw.ext.cargo.query, 'GB_Cargo_Game',
        '_pageName=page,Image,Has_platforms,Deck,Release_date,Release_date__precision,Release_date_type', {
            where = gameQuery.titleWhere('GB_Cargo_Game', titles),
            limit = limit,
        })

    local byTitle = {}
    for _, r in ipairs(ok and results or {}) do
        byTitle[r.page] = r
    end

    local html = mw.html.create('div'):addClass('listing-grid')
    for i = 1, limit do
        local title = titles[i]
        local r = byTitle[title] or {}

        local image = tostring(r.Image or '')
            :gsub('Http', 'http'):gsub('%+', ' '):gsub(' ', '%%20')
        local released = gameQuery.cardDate(r)

        html:wikitext(frame:expandTemplate{
            title = 'GameCard',
            args = {
                url_title = title,
                title = rows[i].display,
                platforms = tostring(r.Has_platforms or ''):gsub('_', ' '),
                release_date = released ~= '' and released or nil,
                deck = r.Deck or '',
                image = image,
            },
        })
    end
    return tostring(html)
end

return p
